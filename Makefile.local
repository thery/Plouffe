# Read by the Makefile generated by rocq makefile.
#   make admit    the long native computations become Admitted (fast build)
#   make qed      back to Qed (full check, slow)
#   make million  build the Million files (the default)
#   make billion  build the Billion files instead
qed admit million billion:
	@sh ./toggle_qed.sh $@

.PHONY: qed admit million billion
